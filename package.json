{
  "name": "pi-dag-workflow",
  "version": "0.0.0",
  "private": true,
  "description": "A lightweight, session-local Todo DAG workflow for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "files": ["src", "README.md", "README.zh-CN.md"],
  "pi": {
    "extensions": ["./src/todos/index.ts", "./src/plan/index.ts", "./src/agents/index.ts", "./src/goal/index.ts", "./src/ui/index.ts"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:tui": "node test/tmux-smoke.mjs",
    "test:flash": "node test/flash-smoke.ts",
    "test:goal-flash": "node test/goal-flash-smoke.ts",
    "test:joint-flash": "node test/m4-flash-smoke.ts",
    "test:performance": "node test/m4-performance.ts",
    "check:pack": "npm pack --dry-run --ignore-scripts",
    "check": "npm run typecheck && npm test && npm run check:pack"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "typebox": "1.3.27",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
