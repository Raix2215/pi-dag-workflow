{
  "name": "pi-dag-workflow",
  "version": "0.1.2",
  "description": "A lightweight, session-local Todo DAG workflow for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raix2215/pi-dag-workflow.git"
  },
  "homepage": "https://github.com/Raix2215/pi-dag-workflow#readme",
  "bugs": {
    "url": "https://github.com/Raix2215/pi-dag-workflow/issues"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "workflow",
    "dag",
    "todo",
    "subagents"
  ],
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./src/todos/index.ts",
      "./src/plan/index.ts",
      "./src/agents/index.ts",
      "./src/goal/index.ts",
      "./src/ui/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:tui": "node test/tmux-smoke.mjs",
    "test:flash": "node test/flash-smoke.ts",
    "test:goal-flash": "node test/goal-flash-smoke.ts",
    "test:joint-flash": "node test/m4-flash-smoke.ts",
    "test:performance": "node test/m4-performance.ts",
    "check:pack": "npm pack --dry-run --ignore-scripts",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run typecheck && npm test && npm run check:pack && npm run check:release"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "typebox": "1.3.27",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
